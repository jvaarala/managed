install_keymaps() {
    echo ""
    echo "🔧 Setting up IntelliJ IDEA keymap..."
    install_symlink "$HOME/shcmanager/managed/IdeaKeymapMacOS.xml" "$HOME/Library/Application Support/JetBrains/IntelliJIdea2025.3/keymaps/IdeaKeymapMacOS.xml"
}

uninstall_keymaps() {
    echo ""
    echo "🔧 Removing IntelliJ IDEA keymap..."
    uninstall_symlink "$HOME/shcmanager/managed/IdeaKeymapMacOS.xml" "$HOME/Library/Application Support/JetBrains/IntelliJIdea2025.3/keymaps/IdeaKeymapMacOS.xml"
}
